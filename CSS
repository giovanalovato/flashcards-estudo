*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, Helvetica, sans-serif;
}

body{
    background:#f4f4f4;
    text-align:center;
    padding:40px;
}

h1{
    margin-bottom:30px;
    color:#333;
}

.container{
    display:flex;
    justify-content:center;
    gap:25px;
    flex-wrap:wrap;
}

.flashcard{
    width:250px;
    height:170px;
    perspective:1000px;
}

.card{
    width:100%;
    height:100%;
    position:relative;
    transform-style:preserve-3d;
    transition:transform .6s;
}

.flashcard:hover .card{
    transform:rotateY(180deg);
}

.front,
.back{
    position:absolute;
    width:100%;
    height:100%;
    border-radius:12px;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:20px;
    backface-visibility:hidden;
    box-shadow:0 4px 10px rgba(0,0,0,.2);
}

.front{
    background:#4CAF50;
    color:white;
    font-size:20px;
    font-weight:bold;
}

.back{
    background:white;
    color:#333;
    transform:rotateY(180deg);
}
